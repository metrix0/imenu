{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-payout",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/reconcile-payouts",
      "schedule": "5 15 * * *"
    },
    {
      "path": "/api/cron/addon-expiry-whatsapp",
      "schedule": "0 18 * * *"
    }
  ]
}
