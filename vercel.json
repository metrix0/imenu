{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "preview": true
    }
  },
  "rewrites": [
    {
      "source": "/cdn/storage/:path*",
      "destination": "https://mjogdsnxbwhbqcoijrwt.supabase.co/storage/v1/object/public/:path*"
    }
  ],
  "headers": [
    {
      "source": "/cdn/storage/:path*",
      "headers": [
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" },
        { "key": "CDN-Cache-Control", "value": "max-age=2592000" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-payout",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/reconcile-payouts",
      "schedule": "5 15 * * *"
    },
    {
      "path": "/api/cron/addon-expiry-whatsapp",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/ia-vendas-analysis",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "30 4 * * *"
    }
  ]
}
