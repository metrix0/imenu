[Unit]
Description=iMenu staging automatic preview deployment
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/opt/imenu-migration/secrets/app-stage.env

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/bash /opt/imenu-migration/ops/deploy-preview.sh
TimeoutStartSec=2h
UMask=0077
Nice=10
IOSchedulingClass=idle
